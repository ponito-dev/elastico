{
    "name": "ponito/elastico",
    "description": "Elasticsearch Eloquent ORM for Laravel: models, query builder, aggregations, ILM and scripted updates on Elasticsearch 8",
    "keywords": [
        "laravel",
        "eloquent",
        "elasticsearch",
        "orm",
        "search",
        "aggregations",
        "ilm"
    ],
    "homepage": "https://github.com/ponito-dev/elastico",
    "support": {
        "issues": "https://github.com/ponito-dev/elastico/issues",
        "source": "https://github.com/ponito-dev/elastico"
    },
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Guy Chaumont",
            "email": "gchaumont@me.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/collections": "^11.0|^12.0",
        "illuminate/support": "^11.0|^12.0",
        "php-http/guzzle7-adapter": "^1.0",
        "elasticsearch/elasticsearch": "^8.2",
        "spatie/laravel-data": "^4.6",
        "illuminate/database": "^11.0|^12.0",
        "filament/filament": "^4.0"
    },
    "require-dev": {
        "illuminate/support": "^11.0|^12.0",
        "illuminate/container": "^11.0|^12.0",
        "illuminate/events": "^11.0|^12.0",
        "filament/upgrade": "^4.0",
        "pestphp/pest": "^3.0"
    },
    "scripts": {
        "test": "vendor/bin/pest"
    },
    "autoload": {
        "psr-4": {
            "Elastico\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Elastico\\ElasticServiceProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "pestphp/pest-plugin": true
        }
    }
}
